{
  // Sync: si en GitHub hay un commit que aquí no está (uno nuestro), el suyo se
  // pone encima sin preguntar. Y no bajar etiquetas, que git no se queje.
  "git.rebaseWhenSync": true,
  "git.pullTags": false,
  // agenda.json y blog-ejemplo.json son listas: su esquema se dice aquí
  "json.schemas": [
    { "fileMatch": ["data/agenda.json"], "url": "./schema/agenda.json" },
    { "fileMatch": ["data/blog-ejemplo.json"], "url": "./schema/blog.json" }
  ]
}
