// La copia de laSADCUM, en Cloudflare: Workers Builds conectado a su repo.
// Se publica en la raíz; con el dominio en data/site.json → "url", se indexa.
// El blog (manus/blog.md) añadirá aquí su Worker ("main"), D1 y R2.
{
  "name": "lasadcum",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
